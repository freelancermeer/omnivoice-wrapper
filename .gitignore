# ── Big / machine-specific things that must NOT go to GitHub ──────────────

# Python virtual environment (recreate on each PC — see README)
venv/
env/
.venv/

# Model weights (~3.3 GB — download separately, see README)
Model/

# Generated output voices + zips
outputs/

# Registered API voice clips
voices/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# ── Local editor / tooling config ─────────────────────────────────────────
.claude/
.vscode/
.idea/
*.code-workspace

# ── Secrets / env ─────────────────────────────────────────────────────────
.env
.env.*
*.key

# ── Logs & temp ───────────────────────────────────────────────────────────
*.log
*.tmp
tmp/
scratch/

# ── OS junk ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Audio artifacts anywhere in the tree (keep repo clean) ────────────────
*.wav
*.zip

# Test / tooling artefacts
.pytest_cache/
*.bak

# Generation / consent audit trail (machine-specific)
logs/

# Cached built voices (rebuildable, machine-specific)
*.omniprompt

# Batch-audit artifacts (regenerate with tools/make_batch.py + audit_batch.py).
# manifest.json points into outputs/, which is ignored above.
manifest.json
audit.json
sample_manifest.json
sample_audit.json
# tools/verify_external.py output — contains transcripts, not secrets, but it
# is a run artifact and is regenerated every time.
external_check.json

# Timestamped copies made before deleting voices. Local safety net, not code.
voices_backup_*/

# Batch artifacts from the verifier-cost measurements.
von.json
voff.json
fw.json
fw_audit.json
before_metrics.json

nov.json
nov_audit.json
